# GigaChat API credentials
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# Доступные голоса: denis, dmitri, irina, ruslan
TTS_VOICE=denis

# Модель распознавания речи
VOSK_MODEL_PATH=recognize_models/vosk-model-small-ru-0.22

# Flask конфигурация
FLASK_SECRET_KEY=your-secret-key-for-sessions
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# RAG настройки
VECTOR_STORE_DIR=vector_store
RAG_MODEL_NAME=all-MiniLM-L6-v2
TOP_K_RESULTS=3
SIMILARITY_THRESHOLD=0.35

# Кэширование
CACHE_ENABLED=true
CACHE_TTL=300

# Сессии
SESSION_TIMEOUT=3600
MAX_HISTORY_LENGTH=10

# Логирование
LOG_LEVEL=INFO